{
  "name": "aktivitetsplan",
  "version": "2.0.0",
  "description": "Aktivitetsplan",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gh-pages": "VITE_USE_HASH_ROUTER=true vite",
    "build:dev-ekstern": "vite build --mode=dev-ekstern --base=https://cdn.nav.no/dab/aktivitetsplan-dev-ekstern/build/",
    "build:dev-intern": "vite build --mode=dev-intern --base=https://cdn.nav.no/dab/aktivitetsplan-dev-intern/build/",
    "build:prod-ekstern": "vite build --mode=prod-ekstern --base=https://cdn.nav.no/dab/aktivitetsplan-prod-ekstern/build/",
    "build:prod-intern": "vite build --mode=prod-intern --base=https://cdn.nav.no/dab/aktivitetsplan-prod-intern/build/",
    "build": "cross-env VITE_USE_HASH_ROUTER=true vite build --mode=dev",
    "build:gh-pages": "VITE_USE_HASH_ROUTER=true vite build --mode=dev-ekstern --base=/aktivitetsplan/",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format-all": "prettier --write 'src/'",
    "lint-staged": "lint-staged",
    "preview": "vite preview"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^3.10.0",
    "@navikt/aksel-icons": "^8.19.1",
    "@nais/apm": "^0.7.3",
    "@navikt/dab-spraksjekk": "^1.0.22",
    "@navikt/ds-css": "^8.19.1",
    "@navikt/ds-react": "^8.19.1",
    "@navikt/ds-tailwind": "^8.19.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "pdfjs-dist": "^6.3.289",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-collapse": "^5.1.1",
    "react-custom-scrollbars-2": "^4.5.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.89.0",
    "react-modal": "^3.16.3",
    "react-pdf": "^11.0.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "rebound": "^0.1.0",
    "redux": "^5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,less,css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 10",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@navikt/nav-dekoratoren-moduler": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/moment-duration-format": "^2.2.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-collapse": "^5.0.4",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "oxlint": "^1.87.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-tailwind-shadowdom": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/navikt/aktivitetsplan.git"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
